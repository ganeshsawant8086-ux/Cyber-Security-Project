# ==============================================================================
# Identity Lifecycle & Access Orchestration Platform - Environment Template
# NOTE: This file is for local development and demonstration only.
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=identity-access-orchestrator
DEBUG=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
WORKER_PORT=8001

# JWT Authentication (Local Demo Key)
# In production, asymmetric keys (RS256/ES256) loaded from GCP Secret Manager / KMS must be used.
JWT_SECRET_KEY=demo-insecure-secret-key-change-in-production-only-32bytes-min
JWT_ALGORITHM=HS256
JWT_ISSUER=urn:identity-orchestrator:demo-auth-service
JWT_AUDIENCE=urn:identity-orchestrator:api
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database
# Local Docker or fallback SQLite (sqlite+aiosqlite:///./demo_identity.db)
DATABASE_URL=postgresql+asyncpg://identity_user:identity_secure_pass_123@localhost:5432/identity_db
DATABASE_SYNC_URL=postgresql://identity_user:identity_secure_pass_123@localhost:5432/identity_db

# Open Policy Agent (OPA)
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=v1/data/identity/authz

# Google Cloud Pub/Sub
GCP_PROJECT_ID=demo-cloud-security-project
PUBSUB_TOPIC_LIFECYCLE=identity-lifecycle-events
PUBSUB_SUBSCRIPTION_LIFECYCLE=identity-lifecycle-worker-sub
PUBSUB_TOPIC_DLQ=identity-lifecycle-dlq
PUBSUB_SUBSCRIPTION_DLQ=identity-lifecycle-dlq-sub
# Set to 'localhost:8085' when running Google Cloud Pub/Sub local emulator
PUBSUB_EMULATOR_HOST=localhost:8085

# Downstream Provisioning Emulation Mode (mock / strict)
PROVISIONER_MODE=mock
DOWNSTREAM_TIMEOUT_SECONDS=5
MAX_RETRY_ATTEMPTS=3
