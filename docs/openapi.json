    "/api/v1/lifecycle/request": {
      "post": {
        "tags": [
          "Identity Lifecycle Orchestration"
        ],
        "summary": "Process Servicenow Request",
        "description": "Receive and evaluate a ServiceNow lifecycle ticket (ONBOARD, ROLE_CHANGE, OFFBOARD).\n\nSteps executed:\n1. Caller authentication via JWT Bearer token\n2. Context-aware ABAC policy check via Open Policy Agent (OPA)\n3. Identity record state updates in PostgreSQL\n4. Lifecycle event publishing to Google Cloud Pub/Sub\n5. Structured audit event generation",
